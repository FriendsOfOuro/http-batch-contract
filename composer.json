{
    "name": "friendsofouro/http-batch-contract",
    "description": "Contract for a batch of HTTP Requests",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.48",
        "friendsofphp/php-cs-fixer": "^3.88"
    },
    "provide": {
        "friendsofouro/http-batch-contract-implementation": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "FriendsOfOuro\\Http\\Batch\\": "src"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    }
}
